# Toolchain binaries are NOT committed — setup/setup.ps1 re-downloads
# and SHA256-verifies them so any agent machine reproduces MANIFEST.json.
/setup/freerouting/*.zip
/setup/freerouting/*.jar
/setup/freerouting/cli/

# local run artifacts
report/
__pycache__/
*.pyc
**/routing_candidate/
**/*.kicad_prl
**/*.dsn
**/*.ses
**/*-drc.json
**/*-routed.kicad_pcb
**/*-routed.kicad_pro
**/*-routed.png
